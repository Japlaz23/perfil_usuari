<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Perfil_usuari" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Colores principales -->
        <item name="colorPrimary">#6750A4</item>
        <item name="colorPrimaryVariant">#4F378B</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Colores secundarios -->
        <item name="colorSecondary">#03A9F4</item>
        <item name="colorSecondaryVariant">#0288D1</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Fondo y superficies -->
        <item name="android:colorBackground">#F8F7FC</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1D1B20</item>

        <!-- Barra superior y navegación -->
        <item name="android:statusBarColor">#4F378B</item>
        <item name="android:navigationBarColor">#F8F7FC</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Texto -->
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>

        <!-- Colores de error -->
        <item name="colorError">#B3261E</item>
        <item name="colorOnError">#FFFFFF</item>

    </style>

</resources>